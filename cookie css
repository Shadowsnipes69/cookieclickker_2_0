@import 'tailwindcss';

@theme {
  --font-display: 'Orbitron', sans-serif;
  --font-heading: 'Rajdhani', sans-serif;
  --font-body: 'Inter', sans-serif;
}

:root {
  --background: #08060f;
  --foreground: #f0e6c8;
  --card: #110d20;
  --card-foreground: #e8d9b8;
  --primary: #f5c518;
  --primary-foreground: #08060f;
  --secondary: #1e1535;
  --secondary-foreground: #b8a888;
  --muted: #16112a;
  --muted-foreground: #7a6a50;
  --accent: #ff6b00;
  --accent-foreground: #fff;
  --border: rgba(245, 197, 24, 0.15);
  --ring: #f5c518;
  --radius: 8px;

  --panel: rgba(17, 13, 32, 0.92);
  --panel-border: rgba(245, 197, 24, 0.25);
  --ki-gold: #f5c518;
  --ki-orange: #ff6b00;
  --shop-button: linear-gradient(135deg, #7138d4, #9b4dca);
  --shadow-soft: 0 14px 35px rgb(0 0 0 / 30%);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  color-scheme: dark;
}

body {
  margin: 0;
  background-color: var(--background);
  color: var(--foreground);
  font-family: var(--font-body);
  line-height: 1.5;
  letter-spacing: 0.01em;
  overflow-x: hidden;
}

img {
  display: block;
  max-width: 100%;
}

button,
input,
textarea,
select {
  font: inherit;
}

::selection {
  background: rgba(245, 197, 24, 0.35);
  color: var(--foreground);
}

* {
  scrollbar-width: thin;
  scrollbar-color: rgba(245, 197, 24, 0.35) transparent;
}

@keyframes pulse-glow {
  0%,
  100% {
    box-shadow: 0 0 20px rgba(245, 197, 24, 0.3), 0 0 60px rgba(245, 197, 24, 0.1);
  }

  50% {
    box-shadow: 0 0 40px rgba(245, 197, 24, 0.6), 0 0 120px rgba(245, 197, 24, 0.2);
  }
}

@keyframes ki-ripple {
  0% {
    transform: scale(1);
    opacity: 0.8;
  }

  100% {
    transform: scale(2.5);
    opacity: 0;
  }
}

@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8px);
  }
}

@keyframes unlock-flash {
  0% {
    background-color: rgba(245, 197, 24, 0);
  }

  30% {
    background-color: rgba(245, 197, 24, 0.25);
  }

  100% {
    background-color: rgba(245, 197, 24, 0);
  }
}

@keyframes number-pop {
  0% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  100% {
    transform: translateY(-60px) scale(0.7);
    opacity: 0;
  }
}

@keyframes aura-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.font-display {
  font-family: var(--font-display);
}

.font-heading {
  font-family: var(--font-heading);
}

.glow-gold {
  text-shadow: 0 0 20px rgba(245, 197, 24, 0.8), 0 0 40px rgba(245, 197, 24, 0.4);
}

.glow-orange {
  text-shadow: 0 0 20px rgba(255, 107, 0, 0.8), 0 0 40px rgba(255, 107, 0, 0.4);
}

.ki-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 176px;
  height: 176px;
  overflow: hidden;
  border: 3px solid rgba(245, 197, 24, 0.6);
  border-radius: 50%;
  background:
    radial-gradient(circle at 40% 35%, rgba(245, 197, 24, 0.25) 0%, rgba(245, 197, 24, 0.06) 50%, transparent 70%),
    var(--card);
  cursor: pointer;
  user-select: none;
  animation: pulse-glow 2.5s ease-in-out infinite, float 3s ease-in-out infinite;
  transition: transform 0.12s ease, filter 0.12s ease, box-shadow 0.15s ease;
}

.ki-btn:hover {
  filter: brightness(1.04);
}

.ki-btn:active,
.ki-btn:focus-visible {
  transform: scale(0.92);
  filter: brightness(1.4);
  animation: none;
}

.ki-btn:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 4px;
}

.ripple {
  position: absolute;
  border: 2px solid rgba(245, 197, 24, 0.6);
  border-radius: 50%;
  animation: ki-ripple 0.7s ease-out forwards;
  pointer-events: none;
}

.unlock-flash {
  animation: unlock-flash 1s ease-out forwards;
}

.float-number {
  position: fixed;
  z-index: 9999;
  pointer-events: none;
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--ki-gold);
  text-shadow: 0 0 10px rgba(245, 197, 24, 0.8);
  animation: number-pop 0.9s ease-out forwards;
}

.ki-symbol {
  font-family: var(--font-display);
  font-size: 3rem;
  font-weight: 900;
  line-height: 1;
  color: var(--primary);
  text-shadow: 0 0 20px var(--primary);
}

.ki-label {
  margin-top: 0.5rem;
  font-family: var(--font-display);
  font-size: 0.75rem;
  letter-spacing: 0.3em;
  color: rgba(245, 197, 24, 0.8);
  text-transform: uppercase;
}

.gohan-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 160px;
  margin: 1.5rem auto;
}

#gohan {
  width: 180px;
  height: auto;
  image-rendering: pixelated;
  animation: gohan-breathe 2.4s ease-in-out infinite,
    gohan-aura 2.4s ease-in-out infinite;
  transform-origin: center bottom;
  filter: drop-shadow(0 0 12px rgba(245, 197, 24, 0.55));
  will-change: transform, filter;
}

@keyframes gohan-breathe {
  0%,
  100% {
    transform: scale(1) translateY(0);
  }

  50% {
    transform: scale(1.035) translateY(-4px);
  }
}

#cookieButton,
#points,
#cookieAmount,
#info,
.container,
#techniqueButton {
  display: block;
  margin-right: auto;
  margin-left: auto;
  text-align: center;
}

#points {
  position: fixed;
  top: 16px;
  right: 16px;
  z-index: 50;
  width: max-content;
  margin-top: 26px;
  padding: 12px;
  border-radius: 8px;
  color: var(--ki-gold);
  font-size: 1.5rem;
  background: rgba(17, 13, 32, 0.7);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.22);
}

#point {
  margin-left: 8px;
  color: #fff;
}

.container {
  display: grid;
  grid-template-columns: minmax(260px, 1fr) minmax(280px, 380px);
  align-items: stretch;
  width: min(100%, 1000px);
  min-height: calc(100vh - 72px);
  margin: 0 auto;
  gap: 44px;
}

.game-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 14px;
  text-align: center;
}

.shop {
  width: 100%;
  min-height: 100%;
  padding: 24px;
  border: 1px solid var(--panel-border);
  border-radius: 18px;
  background: var(--panel);
  box-shadow: var(--shadow-soft);
}

.shop h2 {
  margin-top: 0;
  color: var(--ki-gold);
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.shop > button,
.shop .buy {
  display: block;
  width: 100%;
  margin: 14px 0;
}

.shop ol {
  padding-left: 24px;
  text-align: left;
}

.shop li {
  margin: 12px 0;
}

#techniqueButton {
  width: min(100% - 24px, 480px);
  margin-top: 24px;
  background: linear-gradient(90deg, #3b82f6, #8b5cf6);
  box-shadow: 0 0 18px rgb(59 130 246 / 45%);
}

#techniqueButton:disabled:hover {
    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
}

button {
  min-height: auto;
  padding: 12px 18px;
  border: 0;
  border-radius: 8px;
  background: var(--shop-button);
  color: #fff;
  cursor: pointer;
  transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.15s ease;
}

button:hover {
  filter: brightness(1.18);
  transform: translateY(-2px);
}

button:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: 2px;
}

@media (max-width: 480px) {
  body {
    padding: 22px 12px;
  }

  #cookieButton {
    width: 155px;
    height: 155px;
  }

  .container {
    grid-template-columns: 1fr;
    gap: 26px;
  }

  .shop {
    min-height: auto;
    padding: 18px 14px;
  }
}

button:disabled,
button:disabled:hover {
    cursor: not-allowed;
    filter: brightness(0.55);
    opacity: 0.7;
    transform: none;
}

#kamehamehaStatus {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 12px;
  text-align: center;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.1rem;
  letter-spacing: 0.05em;
  color: var(--ki-gold);
  background: linear-gradient(90deg, #7c3aed, #2563eb, #06b6d4, #f59e0b);
  background-size: 400% 100%;
  animation: kamehameha-glow 3s ease infinite;
  box-shadow: 0 4px 20px rgb(59 130 246 / 55%);
  transition: background 0.4s ease, box-shadow 0.4s ease;
  min-height: 1.5em;
}

@keyframes kamehameha-glow {
  0%,
  100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 200% 50%;
  }
}

@keyframes gohan-aura {
  0%,
  100% {
    filter: drop-shadow(0 0 10px rgba(245, 197, 24, 0.4));
  }
  50% {
    filter: drop-shadow(0 0 22px rgba(255, 107, 0, 0.75));
  }
}

/* Gohan sprites: 8-frame idle loop (breathing + hair sway) + pulsing aura glow.
   Usage: <div class="gohan gohan--ssj1"></div>  */
.gohan{
  --s:1.5;                       /* scale: change this to resize */
  width:calc(var(--w)*var(--s)*1px);
  height:calc(var(--h)*var(--s)*1px);
  background-image:var(--sheet);
  background-size:calc(var(--w)*8*var(--s)*1px) calc(var(--h)*var(--s)*1px);
  image-rendering:pixelated;
  animation:gohan-idle .9s steps(8) infinite, gohan-glow 1.8s ease-in-out infinite;
  transform-origin:50% 100%;
}
.gohan--base    {--w:119;--h:199;--sheet:url(sprites/base_sheet.png);    --glow:#ffffff00}
.gohan--ssj1    {--w:130;--h:232;--sheet:url(sprites/ssj1_sheet.png);    --glow:#ffd84a}
.gohan--ssj2    {--w:172;--h:245;--sheet:url(sprites/ssj2_sheet.png);    --glow:#ffc400}
.gohan--ultimate{--w:158;--h:256;--sheet:url(sprites/ultimate_sheet.png);--glow:#b9c4d6}
.gohan--beast   {--w:167;--h:279;--sheet:url(sprites/beast_sheet.png);   --glow:#a65cff}

@keyframes gohan-idle{
  from{background-position-x:0}
  to{background-position-x:calc(var(--w)*-8*var(--s)*1px)}
}
@keyframes gohan-glow{
  0%,100%{filter:drop-shadow(0 0 2px var(--glow))}
  50%    {filter:drop-shadow(0 0 10px var(--glow)) brightness(1.08)}
}
/* click feedback: add class "hit" from JS for a quick punch-squash */
.gohan.hit{animation:gohan-idle .9s steps(8) infinite, gohan-hit .12s ease-out}
@keyframes gohan-hit{50%{transform:scale(1.06,.94)}}

@media (prefers-reduced-motion:reduce){.gohan{animation:none}}
