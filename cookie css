* {
    box-sizing: border-box;
}

:root {
    --ki-gold: #ffd166;
    --ki-orange: #ff8c42;
    --ki-red: #ef476f;
    --panel: rgb(18 25 48 / 88%);
    --panel-border: rgb(255 209 102 / 35%);
}

body {
    min-height: 100vh;
    margin: 0;
    padding: 36px 20px;
    font-family: "Trebuchet MS", Arial, sans-serif;
    color: #fff;
    background:
        radial-gradient(circle at 50% 10%, rgb(255 140 66 / 28%), transparent 32%),
        linear-gradient(145deg, #090d20, #17112b 55%, #35132e);
}

body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: "";
    opacity: 0.16;
    background-image: linear-gradient(120deg, transparent 48%, #ffd166 49%, transparent 50%);
    background-size: 90px 90px;
    pointer-events: none;
}

#cookieButton,
#points,
#cookieAmount,
#info,
.container,
#KamehamehaUpgrade {
    display: block;
    margin-right: auto;
    margin-left: auto;
    text-align: center;
}

#cookieButton {
    width: 190px;
    height: 190px;
    margin-top: 14px;
    border: 5px solid var(--ki-gold);
    border-radius: 50%;
    background: radial-gradient(circle, #ffcc4d 0 18%, var(--ki-orange) 45%, #d52f45 100%);
    box-shadow: 0 0 20px var(--ki-orange), 0 0 65px rgb(255 209 102 / 45%);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}

#cookieButton:hover {
    background: radial-gradient(circle, #ffe08a 0 18%, #ffad4d 45%, #e94652 100%);
    box-shadow: 0 0 30px var(--ki-gold), 0 0 85px rgb(255 209 102 / 55%);
    transform: scale(1.04);
}

#cookieButton:active {
    transform: scale(0.94);
}

.ki-symbol {
    display: block;
    font-size: 4rem;
    line-height: 1;
}

.ki-label {
    display: block;
    margin-top: 8px;
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: 0.25em;
}

#points {
    margin-top: 26px;
    color: var(--ki-gold);
    font-size: 1.5rem;
}

#point {
    margin-left: 8px;
    color: #fff;
}


.container {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) minmax(280px, 380px);
    align-items: stretch;
    width: min(100%, 1000px);
    min-height: calc(100vh - 72px);
    margin: 0 auto;
    gap: 44px;
}

.game-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 14px;
    text-align: center;
}

.shop {
    width: 100%;
    min-height: 100%;
    padding: 24px;
    border: 1px solid var(--panel-border);
    border-radius: 18px;
    background: var(--panel);
    box-shadow: 0 14px 35px rgb(0 0 0 / 30%);
}

.shop h2 {
    margin-top: 0;
    color: var(--ki-gold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
}

.shop > button,
.shop .buy {
    display: block;
    width: 100%;
    margin: 14px 0;
}

.shop ol {
    padding-left: 24px;
    text-align: left;
}

.shop li {
    margin: 12px 0;
}

#KamehamehaUpgrade {
    display: block;
    margin-top: 24px;
    margin-right: auto;
    margin-left: auto;
    background: linear-gradient(90deg, #3b82f6, #8b5cf6);
    box-shadow: 0 0 18px rgb(59 130 246 / 45%);
}

#KamehamehaUpgrade:hover {
    background: linear-gradient(90deg, #60a5fa, #a78bfa);
}

button {
    border: 0;
    border-radius: 8px;
    padding: 12px 18px;
    cursor: pointer;
    font: inherit;
    color: #fff;
    background: linear-gradient(135deg, #7138d4, #9b4dca);
        min-height: auto;
    transition: transform 0.15s ease, filter 0.15s ease;
}

button:hover {
    filter: brightness(1.18);
    transform: translateY(-2px);
}

@media (max-width: 480px) {
    body {
        padding: 22px 12px;
    }

    #cookieButton {
        width: 155px;
        height: 155px;
    }

    .ki-symbol {
        font-size: 3.2rem;
    }

    .container {
        grid-template-columns: 1fr;
        gap: 26px;
    }

    .shop {
        min-height: auto;
        padding: 18px 14px;
    }
}
