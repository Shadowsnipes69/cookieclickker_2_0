const cookieButton = document.getElementById("cookieButton");
const cookieAmount = document.getElementById("cookieAmount");
const upgradeClickerButton = document.getElementById("upgradeClicker");
const autoClickerButton = document.getElementById("autoClicker");
const kamehamehaStatusEl = document.getElementById("kamehamehaStatus");
const techniqueButton = document.getElementById("techniqueButton");
const creatorMode =
  window.location.protocol === "file:" ||
  ["localhost", "127.0.0.1", "::1"].includes(window.location.hostname);

let ki = 0;
let multiplier = 1;
let multiplierCost = 50;

let autoClickers = 0;
let autoClickerCost = 100;

let nextImageSrc = "";
let autoClickerInterval = null;

const techniqueData = [
  { name: "Kamehameha", requiredKi: 150, cooldown: 60 },
  { name: "Masenko", requiredKi: 750, cooldown: 60 },
  { name: "Masendan", requiredKi: 2250, cooldown: 60 },
  { name: "Hidden Potential", requiredKi: 6750, cooldown: 60 },
  { name: "Ultimate Kamehameha", requiredKi: 10000, cooldown: 60 },
  { name: "Ultimate Explosive Kamehameha", requiredKi: 20000, cooldown: 180 },
  { name: "Super Saiyan", requiredKi: 25000, cooldown: 180 },
  { name: "Super Saiyan 2", requiredKi: 30000, cooldown: 180 },
  { name: "Father-Son Kamehameha", requiredKi: 35000, cooldown: 180 },
  { name: "Twin Dragon Shot", requiredKi: 40000, cooldown: 180 },
  { name: "Electric Kamehameha", requiredKi: 50000, cooldown: 300 },
  { name: "Grown Up", requiredKi: 75000, cooldown: 300 },
  { name: "Beast Gohan", requiredKi: 150000, cooldown: 300 },
  { name: "Special Beam Cannon", requiredKi: 200000, cooldown: 300 },
  { name: "Makankosappo", requiredKi: 250000, cooldown: 300 },
];

let currentTechniqueIndex = 0;
let cooldownLeft = 0;
let cooldownTechniqueName = "";
let techniqueTimer = null;

const gohanStages = [
  { src: "base.gif", label: "Base Gohan" },
  { src: "ssj1.gif", label: "Super Saiyan Gohan" },
  { src: "ssj2.gif", label: "Super Saiyan 2 Gohan" },
  { src: "ultimate.gif", label: "Adult Gohan" },
  { src: "beast.gif", label: "Beast Gohan" },
];

function formatNumber(value) {
  return new Intl.NumberFormat("en-US").format(value);
}

function updateGohanImage(stageIndex) {
  const imageStageIndex = Math.min(
    gohanStages.length - 1,
    Math.floor(stageIndex / 3)
  );
  const current = gohanStages[imageStageIndex];
  const img = document.getElementById("gohan");
  if (!img || nextImageSrc === current.src) return;
  nextImageSrc = current.src;
  img.src = current.src;
  img.alt = current.label;
}

function updateTechniqueButton() {
  const nextTechnique = techniqueData[currentTechniqueIndex];
  if (!nextTechnique) {
    techniqueButton.textContent = cooldownLeft > 0
      ? `${cooldownTechniqueName} cooldown: ${cooldownLeft}s`
      : "All techniques unlocked!";
    techniqueButton.disabled = true;
    return;
  }

  if (cooldownLeft > 0) {
    techniqueButton.textContent = `${nextTechnique.name} available in ${cooldownLeft}s`;
    techniqueButton.disabled = true;
  } else {
    techniqueButton.textContent =
      `${nextTechnique.name} · ${formatNumber(nextTechnique.requiredKi)} KI`;
    techniqueButton.disabled = ki < nextTechnique.requiredKi;
  }
}

function updateShopButtons() {
  upgradeClickerButton.disabled = ki < multiplierCost;
  autoClickerButton.disabled = ki < autoClickerCost;
  updateTechniqueButton();
}

function updateCookieAmount() {
  cookieAmount.textContent = "You have " + ki + " ki!";
  updateGohanImage(currentTechniqueIndex);
  updateShopButtons();
}

function clickKi() {
  ki += multiplier;
  updateCookieAmount();
}

function buyMultiplier() {
  if (ki >= multiplierCost) {
    ki -= multiplierCost;
    multiplierCost = Math.ceil(multiplierCost * 1.3);
    multiplier += 1;
    updateCookieAmount();
    upgradeClickerButton.textContent = "Upgrade clicker for " + multiplierCost + " ki";
  } else {
    alert("Not enough Ki");
  }
}

function buyAutoClicker() {
  if (ki >= autoClickerCost) {
    ki -= autoClickerCost;
    autoClickers += 1;
    autoClickerCost = Math.ceil(autoClickerCost * 1.25);
    updateCookieAmount();
    autoClickerButton.textContent = "Purchase auto clicker for " + autoClickerCost + " ki";

    if (autoClickerInterval === null) {
      autoClickerInterval = setInterval(() => {
        ki += autoClickers;
        updateCookieAmount();
      }, 1000);
    }
  } else {
    alert("Not enough Ki");
  }
}

function activateNextTechnique() {
  const technique = techniqueData[currentTechniqueIndex];
  if (!technique || ki < technique.requiredKi || cooldownLeft > 0) return;

  currentTechniqueIndex += 1;
  cooldownTechniqueName = technique.name;
  if (creatorMode) {
    kamehamehaStatusEl.textContent = `${technique.name} activated!`;
    updateCookieAmount();
    return;
  }

  cooldownLeft = technique.cooldown;
  kamehamehaStatusEl.textContent =
    `${technique.name} activated. Cooldown: ${cooldownLeft}s`;
  techniqueTimer = setInterval(() => {
    cooldownLeft = Math.max(0, cooldownLeft - 1);
    kamehamehaStatusEl.textContent = cooldownLeft > 0
      ? `${cooldownTechniqueName} cooldown: ${cooldownLeft}s`
      : "";
    updateCookieAmount();

    if (cooldownLeft === 0) {
      clearInterval(techniqueTimer);
      techniqueTimer = null;
    }
  }, 1000);
  updateCookieAmount();
}

cookieButton.addEventListener("click", clickKi);
upgradeClickerButton.addEventListener("click", buyMultiplier);
autoClickerButton.addEventListener("click", buyAutoClicker);
techniqueButton.addEventListener("click", activateNextTechnique);

updateCookieAmount();
